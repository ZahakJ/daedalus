{
  "name": "daedalus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5701 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "build:pages": "tsc -p tsconfig.json && vite build --mode pages",
    "preview": "vite preview --port 6701 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node tools/screenshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.50.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
